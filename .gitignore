# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Playwright CLI output (may contain credentials)
.playwright-cli/

# Local AI / editor tooling — not part of the website
/.agents/
/.claude/
/.mcp.json
/skills-lock.json
/.playwright/

# Source product folders (large originals). The processed WebP in
# public/catalog/ and src/data/catalog.json are what ship.
/Impact Store/

# Catalogue originals (large, and phone photos carry GPS location).
# The site ships the optimised copies in public/catalog/ and src/data/catalog.json.
/catalog/photos/*
!/catalog/photos/.gitkeep
